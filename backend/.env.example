# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_ENABLED=false

# Groq (OpenAI-compatible). One-line model swap, e.g. openai/gpt-oss-20b
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
PLANNER_STUB=true
# Optional second call: short Polish reason for each top search hit
SEARCH_LLM_REASONS=false

# Weather adapter
# stub | open_meteo | imgw_inpost (IMGW synop + optional InPost air for /current; Open-Meteo for /forecast)
WEATHER_PROVIDER=imgw_inpost
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_CACHE_TTL_SECONDS=300

# InPost Air (optional; enriches /weather/current when locker has sensors)
INPOST_LOCKER_CODE=
INPOST_LOCKER_ID=
INPOST_ENABLED=true

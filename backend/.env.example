# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_ENABLED=false

# Remote Bielik (OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=speakleash/bielik-11b-v2.3-instruct:Q4_K_M
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
PLANNER_STUB=true

# Weather adapter
# stub | open_meteo | imgw_inpost (IMGW synop + optional InPost air for /current; Open-Meteo for /forecast)
WEATHER_PROVIDER=imgw_inpost
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_CACHE_TTL_SECONDS=300

# InPost Air (optional; enriches /weather/current when locker has sensors)
INPOST_LOCKER_CODE=
INPOST_LOCKER_ID=
INPOST_ENABLED=true
